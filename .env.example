# ===== MAJBURIY =====
# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAA-bbbbCCCCddddEEEEffffGGGG
# Bot egasining Telegram ID raqami (@userinfobot ko'rsatadi)
ADMIN_ID=123456789
# Bot username — "@" BELGISIZ! (@ qo'yilsa "Guruhga qo'shish" tugmasi ishlamaydi)
BOT_USERNAME=mening_botim

# ===== IXTIYORIY =====
# Qo'shimcha adminlar (vergul bilan). ADMIN_ID asosiy bo'lib qoladi —
# bildirishnomalar va shaxsiy xabarlar faqat unga boradi.
# ADMIN_IDS=111111,222222

# Har qanday @username reklama deb bloklansinmi.
# false (default) = oddiy tag jazolanmaydi, faqat reklama konteksti bloklanadi.
# BLOCK_MENTIONS=false

# Oddiy xabarlar matni bazaga yozilsinmi (maxfiylik).
# false (default) = faqat spam/flood xabarlari dalil sifatida saqlanadi.
# LOG_MESSAGE_TEXT=false

# Bot o'chiq paytda kelgan xabarlar tashlab yuborilsinmi.
# false (default) = hammasi ko'rib chiqiladi.
# DROP_PENDING_UPDATES=false

# Baza va backup joylashuvi (default: loyiha papkasi)
# DB_PATH=/opt/clearbot/bot/bot_data.db
# BACKUP_DIR=/opt/clearbot/bot/backups

# ===== WEBHOOK (faqat Cloud Run / shunga o'xshash muhit uchun) =====
# Bo'sh qoldirilsa bot long-polling'da ishlaydi — hech qanday port ochilmaydi.
# WEBHOOK_URL=https://mening-botim.run.app/
# WEBHOOK_SECRET=uzun-tasodifiy-satr   # BO'SH QOLDIRMANG! Aks holda URL'ni bilgan
#                                       # har kim botga soxta xabar yuborishi mumkin
# PORT=8080
